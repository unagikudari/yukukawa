# Kawa Phase 0 — local configuration example. Copy to .env (git-ignored) and adjust.
# The repository ships placeholders only; never commit a real .env.

# PostgreSQL DSN for the local kawa database (libpq / psycopg format).
# Default assumes a local `kawa` database reachable over the unix socket (peer auth).
KAWA_DSN=dbname=kawa

# Domain identity this checkout writes Events as (synthetic placeholders).
KAWA_ORIGIN_NODE=node-a
KAWA_ACTOR_REF=vendor-local
